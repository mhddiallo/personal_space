# Copie ce fichier en ".env" SUR LE SERVEUR et remplis-le. Ne le commite jamais.

# Ton code d'accès à 8 chiffres
AUTH_CODE=

# Mot de passe de la base Postgres du VPS : lettres et chiffres uniquement.
# Génère-en un avec :  openssl rand -hex 24
POSTGRES_PASSWORD=

# Adresse du site : ton domaine (HTTPS automatique) ou ":80" si tu n'en as pas
SITE_ADDRESS=:80
# URL publique correspondante (ex: https://maison.exemple.com ou http://IP)
PUBLIC_URL=http://localhost
